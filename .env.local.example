ANTHROPIC_API_KEY=sk-ant-ВАШ_КЛЮЧ_ЗДЕСЬ
# Модель для анализа фото/видео (точность важнее цены)
ANTHROPIC_MODEL_VISION=claude-sonnet-5
# Модель для обычного текстового чата (дешевле, для большинства запросов)
ANTHROPIC_MODEL_TEXT=claude-haiku-4-5-20251001

# RAG по базе знаний (app/api/chat/route.ts searchKnowledge) — без этих трёх
# переменных поиск по базе знаний молча отключается, чат работает без RAG-контекста.
SUPABASE_URL=https://ВАШ_ПРОЕКТ.supabase.co
SUPABASE_ANON_KEY=ВАШ_ANON_КЛЮЧ
OPENAI_API_KEY=sk-proj-ВАШ_КЛЮЧ_ЗДЕСЬ

# Drive sync (/api/sync). Server-only; never use NEXT_PUBLIC_ for these values.
# Vercel sends CRON_SECRET in Authorization: Bearer ...; SYNC_SECRET is a legacy fallback.
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SERVICE_ROLE_KEY
GOOGLE_SERVICE_ACCOUNT={"client_email":"REPLACE","private_key":"REPLACE"}
# Optional: defaults to the existing project folder.
GOOGLE_DRIVE_FOLDER_ID=10MppomAtLV-B6cexyNEA5J2pwp7bSPXl
